# Database --------------------------------------------------------------------
# PostgreSQL connection string. Local dev example shown; replace with your own.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/euphrat_dev"

# HTTP ------------------------------------------------------------------------
PORT=3001
APP_URL=http://localhost:3001

# CORS — comma-separated origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000

# Media storage ---------------------------------------------------------------
# Selects the storage adapter (see apps/api/src/media/). Either "local" or "r2".
STORAGE_DRIVER=local

# Cloudflare R2 (only required when STORAGE_DRIVER=r2)
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
